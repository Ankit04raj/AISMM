# Production template. Copy to .env, fill ALL required values, keep it out of git.
# For a local-only setup use: python scripts/init_local.py
ENVIRONMENT=production
DEBUG=false
# Generate each separately: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET_KEY=
# Hex-only password is easiest in a DATABASE_URL. Do not use the sample DB password from old docs.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://aismm:REPLACE@postgres:5432/aismm
REDIS_URL=redis://redis:6379/0
FRONTEND_URL=https://your-domain.example
CORS_ORIGINS=["https://your-domain.example"]
ENABLE_EMAIL_NOTIFICATIONS=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=
FROM_NAME=AISMM
ENABLE_PHONE_VERIFICATION=false
# Official app approvals and matching callback URL are required.
# Register exactly: https://your-domain.example/oauth/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Meta flows are unavailable until API + Page selection are updated and validated.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
WEBHOOK_SECRET=
# Only operator-controlled, public HTTPS storage hosts; never redirects to internal URLs.
MEDIA_ALLOWED_HOSTS=[]
LOG_LEVEL=INFO
DATABASE_ECHO=false
