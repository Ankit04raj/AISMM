# =====================================================================
# AISMM — Docker Production / Staging Environment Configuration
# Copy this file to .env before starting containers: `cp .env.docker.example .env`
# =====================================================================

# Runtime Environment
ENVIRONMENT=production
DEBUG=False
LOG_LEVEL=INFO

# Security & Master Secrets (MUST be random 32+ char values in production)
# Generate with: openssl rand -hex 32
SECRET_KEY=replace_with_a_secure_random_secret_key_at_least_32_chars_long_prod
JWT_SECRET_KEY=replace_with_a_secure_random_jwt_secret_key_at_least_32_chars_prod
WEBHOOK_SECRET=replace_with_a_secure_random_webhook_secret_key_prod
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_secure_postgres_password
POSTGRES_DB=aismm_db
DATABASE_URL=postgresql+asyncpg://postgres:replace_with_secure_postgres_password@postgres:5432/aismm_db

# Redis Cache & Message Broker
REDIS_URL=redis://redis:6379/0

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost"]
