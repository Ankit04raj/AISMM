# =============================================================================
# AISMM — Environment Configuration & Production Template
# =============================================================================
# Copy this file to `.env` and supply all required keys for your environment.
# Never commit your `.env` file to version control.

# Application Environment
ENVIRONMENT=production
DEBUG=false
APP_NAME=AISMM
APP_VERSION=0.1.0

# Base URLs & Domain Configuration
# Development: FRONTEND_URL=http://localhost:5173, CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# Production: Set to your actual public HTTPS domain
FRONTEND_URL=https://your-domain.example
CORS_ORIGINS=["https://your-domain.example"]

# Core Security Keys — Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL recommended for production, SQLite for local dev)
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://aismm:REPLACE_PASSWORD@postgres:5432/aismm
DATABASE_ECHO=false

# Redis Cache & Rate Limiting
REDIS_URL=redis://redis:6379/0

# Email & SMTP Settings (Required in Production for User Verification)
ENABLE_EMAIL_NOTIFICATIONS=true
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=
FROM_EMAIL=noreply@your-domain.example
FROM_NAME=AISMM

# Phone/SMS Verification (Optional)
ENABLE_PHONE_VERIFICATION=false
SMS_PROVIDER=
SMS_API_KEY=

# =============================================================================
# Third-Party Social Media OAuth 2.0 Credentials
# =============================================================================
# All providers use the standardized callback URI:
# Callback URL: https://your-domain.example/oauth/callback
# (Local dev callback: http://localhost:5173/oauth/callback or http://localhost:3000/oauth/callback)

# 1. X (Twitter) API v2 (PKCE Authorization Code Flow)
# Portal: https://developer.twitter.com/en/portal/dashboard
# - App Settings -> User authentication settings -> Set Type of App to "Web App"
# - Callback URL: https://your-domain.example/oauth/callback
# - Scopes required: tweet.read, tweet.write, users.read, offline.access, like.read, like.write
X_CLIENT_ID=
X_CLIENT_SECRET=

# 2. LinkedIn OpenID & Community Management API (3-Legged OAuth 2.0)
# Portal: https://www.linkedin.com/developers/apps
# - Auth tab -> OAuth 2.0 settings -> Add Authorized redirect URLs
# - Redirect URL: https://your-domain.example/oauth/callback
# - Scopes: openid, profile, email, w_member_social, r_organization_social, w_organization_social
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# 3. Google Cloud Console / YouTube Data API v3 (OAuth 2.0)
# Portal: https://console.cloud.google.com/apis/credentials
# - APIs & Services -> Credentials -> Create Credentials -> OAuth Client ID -> Web application
# - Authorized redirect URIs: https://your-domain.example/oauth/callback
# - Scopes: https://www.googleapis.com/auth/youtube.upload, https://www.googleapis.com/auth/youtube.readonly, https://www.googleapis.com/auth/yt-analytics.readonly
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# 4. Meta Graph API (Instagram Business & Facebook Pages)
# Portal: https://developers.facebook.com/apps
# - Facebook Login for Business -> Settings -> Valid OAuth Redirect URIs
# - Redirect URI: https://your-domain.example/oauth/callback
# - Scopes: pages_show_list, pages_read_engagement, pages_manage_posts, instagram_graph_user_profile, instagram_graph_user_media, instagram_manage_comments
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Webhook Verification Secret
WEBHOOK_SECRET=

# Storage & Media Validation (Only operator-controlled public HTTPS storage hosts)
MEDIA_ALLOWED_HOSTS=["storage.googleapis.com","s3.amazonaws.com"]

# Logging
LOG_LEVEL=INFO

