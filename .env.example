# =====================================================================
# AISMM — Universal AI Social Media Management System Environment Config
# (Copy to .env and configure for local or production deployments)
# =====================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False
LOG_LEVEL=INFO

# Security & Authentication
SECRET_KEY=replace_with_a_secure_random_secret_key_at_least_32_chars
JWT_SECRET_KEY=replace_with_jwt_secret_key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=60
BCRYPT_ROUNDS=12

# Database & Cache
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aismm_db
DATABASE_ECHO=False
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# ---------------------------------------------------------------------
# Social Media Platform OAuth & API Credentials (Placeholders)
# ---------------------------------------------------------------------

# 1. Instagram Graph API
INSTAGRAM_CLIENT_ID=your_instagram_app_id
INSTAGRAM_CLIENT_SECRET=your_instagram_app_secret
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/v1/auth/instagram/callback
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=your_instagram_webhook_verify_token

# 2. Facebook Graph API
FACEBOOK_CLIENT_ID=your_facebook_app_id
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/v1/auth/facebook/callback
FACEBOOK_WEBHOOK_VERIFY_TOKEN=your_facebook_webhook_verify_token

# 3. X (Twitter API v2)
X_CLIENT_ID=your_x_oauth2_client_id
X_CLIENT_SECRET=your_x_oauth2_client_secret
X_REDIRECT_URI=http://localhost:8000/api/v1/auth/x/callback
X_API_KEY=your_twitter_api_consumer_key
X_API_SECRET=your_twitter_api_consumer_secret
X_BEARER_TOKEN=your_twitter_bearer_token

# 4. LinkedIn REST & UGC API
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/auth/linkedin/callback

# 5. YouTube Data API v3 & Analytics
YOUTUBE_CLIENT_ID=your_google_oauth_client_id
YOUTUBE_CLIENT_SECRET=your_google_oauth_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/auth/youtube/callback
YOUTUBE_API_KEY=your_google_api_key
